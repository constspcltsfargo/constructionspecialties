/**
 * @fileoverview Firestore Security Rules for Construction Specialties CMS.
 *
 * Core Philosophy: This ruleset enforces a role-based access control model, granting admin privileges based on membership in the `/roles_admin/{userId}` collection.
 *
 * Data Structure:
 * - `/pages/{pageId}`: Stores page content.
 * - `/pages/{pageId}/pageElements/{pageElementId}`: Stores page elements associated with pages. Includes denormalized `pageId`.
 * - `/media/{mediaId}`: Stores media files.
 * - `/roles_admin/{userId}`: Indicates administrator status.
 *
 * Key Security Decisions:
 * - Admin privileges are determined by the existence of a document in the `/roles_admin/{userId}` collection.
 * - Only admins can create, update, or delete pages, page elements, and media.
 * - Public read access is not granted to any collections.
 * - The first user can self-assign the admin role. Subsequent admin roles can only be granted by existing admins.
 *
 * Denormalization for Authorization:
 * - Admin status is checked via document existence in `/roles_admin/{userId}`, avoiding data reads during page/media access.
 *
 * Structural Segregation:
 * - CMS content (pages, media) is separated into top-level collections to simplify access control.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Grants access to pages only to admins.
     * @path /pages/{pageId}
     * @allow (create) User with a document in /roles_admin/{uid} creates a new page.
     * @deny (create) User without a document in /roles_admin/{uid} attempts to create a page.
     * @allow (get) User with a document in /roles_admin/{uid} retrieves a page.
     * @deny (get) User without a document in /roles_admin/{uid} attempts to retrieve a page.
     * @allow (list) User with a document in /roles_admin/{uid} lists all pages.
     * @deny (list) User without a document in /roles_admin/{uid} attempts to list pages.
     * @allow (update) User with a document in /roles_admin/{uid} updates a page.
     * @deny (update) User without a document in /roles_admin/{uid} attempts to update a page.
     * @allow (delete) User with a document in /roles_admin/{uid} deletes a page.
     * @deny (delete) User without a document in /roles_admin/{uid} attempts to delete a page.
     * @principle Enforces role-based access control, granting admin privileges.
     */
    match /pages/{pageId} {
      allow read, write: if isAdmin();
    }

    /**
     * @description Grants access to page elements only to admins.
     * @path /pages/{pageId}/pageElements/{pageElementId}
     * @allow (create) User with a document in /roles_admin/{uid} creates a new page element.
     * @deny (create) User without a document in /roles_admin/{uid} attempts to create a page element.
     * @allow (get) User with a document in /roles_admin/{uid} retrieves a page element.
     * @deny (get) User without a document in /roles_admin/{uid} attempts to retrieve a page element.
     * @allow (list) User with a document in /roles_admin/{uid} lists all page elements.
     * @deny (list) User without a document in /roles_admin/{uid} attempts to list page elements.
     * @allow (update) User with a document in /roles_admin/{uid} updates a page element.
     * @deny (update) User without a document in /roles_admin/{uid} attempts to update a page element.
     * @allow (delete) User with a document in /roles_admin/{uid} deletes a page element.
     * @deny (delete) User without a document in /roles_admin/{uid} attempts to delete a page element.
     * @principle Enforces role-based access control, granting admin privileges.
     */
    match /pages/{pageId}/pageElements/{pageElementId} {
      allow read, write: if isAdmin();
    }

    /**
     * @description Grants access to media files only to admins.
     * @path /media/{mediaId}
     * @allow (create) User with a document in /roles_admin/{uid} creates a new media file.
     * @deny (create) User without a document in /roles_admin/{uid} attempts to create a media file.
     * @allow (get) User with a document in /roles_admin/{uid} retrieves a media file.
     * @deny (get) User without a document in /roles_admin/{uid} attempts to retrieve a media file.
     * @allow (list) User with a document in /roles_admin/{uid} lists all media files.
     * @deny (list) User without a document in /roles_admin/{uid} attempts to list media files.
     * @allow (update) User with a document in /roles_admin/{uid} updates a media file.
     * @deny (update) User without a document in /roles_admin/{uid} attempts to update a media file.
     * @allow (delete) User with a document in /roles_admin/{uid} deletes a media file.
     * @deny (delete) User without a document in /roles_admin/{uid} attempts to delete a media file.
     * @principle Enforces role-based access control, granting admin privileges.
     */
    match /media/{mediaId} {
      allow read, write: if isAdmin();
    }

    /**
     * @description Allows the first user to become an admin, and allows existing admins to grant roles.
     * @path /roles_admin/{userId}
     * @allow (create) The first user creates their own admin role.
     * @allow (create) An existing admin creates an admin role for another user.
     * @deny (create) A non-admin attempts to create an admin role when admins already exist.
     * @allow (read, write) Admin can manage admin role documents.
     * @deny (read, write) Non-admin attempts to manage admin role documents.
     * @principle Secures admin role management while enabling initial setup.
     */
    match /roles_admin/{userId} {
      allow read, write: if isAdmin();
      allow create: if (isFirstAdmin() && request.auth.uid == userId) || isAdmin();
    }

    // ---- Helper functions ----

    /**
     * @description Checks if the current user is an admin by verifying the existence of a document in `/roles_admin/{uid}`.
     * @return {boolean} True if the user is an admin, false otherwise.
     */
    function isAdmin() {
      return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    /**
     * @description Checks if there are no admin documents in the roles_admin collection.
     * @return {boolean} True if the collection is empty, false otherwise.
     */
    function isFirstAdmin() {
      return !exists(/databases/$(database)/documents/roles_admin);
    }
  }
}