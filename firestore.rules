
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Public read for gallery, admin write
    match /media/{mediaId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.role == 'admin';
    }

    // Allow logged-in users to manage their own profile
    match /users/{userId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null;
    }

    // Public read for pages, admin write for all sub-documents
    match /pages/{pageId}/{document=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.role == 'admin';
    }

    match /estimateRequests/{requestId} {
      // Allow anyone to create an estimate request
      allow create: if true;
      // Admins can read, list and write all estimate requests
      allow read, write, list: if request.auth != null && request.auth.token.role == 'admin';
    }

    match /folders/{folderId} {
      allow read, write: if request.auth != null && request.auth.token.role == 'admin';
    }
  }
}
