
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAdmin() {
      return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Rules for user profiles
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isOwner(userId);
    }
    
    // Rules for admin roles
    match /roles_admin/{userId} {
      allow read: if true;
      // Allow create only if the user is authenticated, the roles_admin collection is empty, and the user is creating their own document.
      allow create: if request.auth != null && !exists(/databases/$(database)/documents/roles_admin) && isOwner(userId);
      allow write: if isAdmin();
    }
    
    // Rules for pages and page elements
    match /pages/{pageId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /pages/{pageId}/pageElements/{pageElementId} {
        allow read: if true;
        allow write: if isAdmin();
    }

    // Rules for media
    match /media/{mediaId} {
        allow read: if true;
        allow write: if isAdmin();
    }

    // Rules for estimate requests
    match /estimateRequests/{requestId} {
        allow read, write: if isAdmin();
        allow create: if request.auth == null || request.auth != null;
    }
  }
}
