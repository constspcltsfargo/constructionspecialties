
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      // Allow read and write access for any authenticated user.
      // This is a permissive rule, suitable for development.
      // For production, you should implement more granular security.
      allow read, write: if request.auth != null;
    }
  }
}
