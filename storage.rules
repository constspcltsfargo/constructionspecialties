
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper function to check if the user is an admin by checking Firestore.
    // Note: This requires the full path to the roles_admin document.
    function isAdmin(userId) {
      return exists(/databases/(default)/documents/roles_admin/$(userId));
    }

    // Default: Deny all reads and writes to all files.
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Allow public read access for all files in the 'uploads' folder.
    // This lets anyone visiting your site view the images.
    match /uploads/{allPaths=**} {
      allow read: if true;
    }
    
    // Only allow authenticated admins to upload, update, or delete files
    // in the 'uploads' folder.
    match /uploads/{allPaths=**} {
        allow write: if request.auth != null && isAdmin(request.auth.uid);
    }
  }
}
