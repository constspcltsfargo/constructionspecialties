
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Allow anyone to read files. This is safe for public assets like gallery images.
    match /{allPaths=**} {
      allow read: if true;
      // Only authenticated users with an admin role can write.
      allow write: if request.auth != null && request.auth.token.role == 'admin';
    }
  }
}
